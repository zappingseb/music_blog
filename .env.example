# Copy this file to .env and fill in the real values. .env is gitignored.
#
#   cp .env.example .env
#
# Then check everything is reachable:
#
#   .venv/bin/python -m musicblog.publish check


# --- WordPress -------------------------------------------------------------

WP_URL=https://engel-wolf.com
WP_USER=<wordpress user name>

# MUST be an Application Password, not the login password -- the REST API
# rejects the account password by design.
# Create one at: wp-admin -> Users -> Profile -> Application Passwords
# Spaces in the generated password are fine, paste it as shown.
WP_PWD=<application password>


# --- Header image size -----------------------------------------------------
# The two header variants (<post_id>.jpg and <post_id>_g.jpg) are rendered to
# exactly this size. Note the inconsistent spelling: "dimension_height" but
# "dimensions_width". That is how it already was on the blog, so the code
# accepts either spelling for both keys rather than renaming them.

WP_gallery_dimension_height=194
WP_gallery_dimensions_width=830


# --- FTP -------------------------------------------------------------------
# Used for the gallery photos, the header images, and deploying the plugin.

# Host or IP. An ftp:// or ftps:// prefix is stripped, and a :port suffix is
# honoured (default 21).
FTP_IP=ftp://<host or ip>
FTP_USER=<ftp user>
FTP_PWD=<ftp password>

# A HINT, not a path. On hosts where the FTP login does not land in the
# document root -- engel-wolf.com lands in / with the docroot at
# /domains/engel-wolf.com/public_html -- the directory containing wp-load.php
# is detected and this value is only used to help the search.
FTP_FOLDER=public_html


# --- Import endpoint -------------------------------------------------------
# Shared secret for wp-content/plugins/sew-claude-music/ngg-helper.php, the
# endpoint that registers galleries with NextGEN. It is substituted into the
# file at deploy time by "publish plugin-push", so it never sits in the repo.
#
# Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

NGG_HELPER_TOKEN=<a long random secret, at least 16 characters>
